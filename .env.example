# Application Environment Configuration
APP_NAME=AI Agent Factory v2
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & Authentication
JWT_SECRET=super-secret-key-change-in-production-at-least-32-chars-long!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage & Persistence
DATA_ROOT=./data
SQLITE_DB_PATH=./data/app.db
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
CHROMA_PERSIST_DIR=./data/chroma

# Document Ingestion
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# LLM Routing & Strategy
LLM_ROUTING_MODE=development
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# API Keys (Optional in Dev - Mock/Local will be used if keys are not provided)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
